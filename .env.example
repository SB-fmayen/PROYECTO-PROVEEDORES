API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=CRUD_PROVEEDORES
ORACLE_PASSWORD=
SQLSERVER_HOST=localhost
SQLSERVER_INSTANCE=SQLEXPRESS
# Si SQL Browser no funciona, indicar el puerto TCP real y omitir INSTANCE.
SQLSERVER_PORT=
SQLSERVER_DATABASE=CuentasPorPagarDB
# Mantener dbo hasta aplicar y verificar 040_security_schema.sql como administrador.
SQLSERVER_SCHEMA=dbo
# El pool de la API requiere autenticacion SQL; Windows solo para diagnosticos.
SQLSERVER_AUTH=sql
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERTIFICATE=false
SESSION_TTL_SECONDS=1800
SESSION_SECURE=false
# Inicializacion de la primera cuenta de aplicacion (no credenciales de BD).
# auth:bootstrap genera password aleatorio y lo conserva cifrado fuera de .env.
APP_ADMIN_LOGIN=
