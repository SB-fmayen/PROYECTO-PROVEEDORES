digraph MER {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.6, ranksep=1.2, splines=polyline, fontname="Arial", labelloc=t, labeljust=l, fontsize=26, label="Oracle | Cuentas por pagar\nADMIN_CU_PROVEEDORES - 11 tablas - 11 relaciones FK\nVerificado 2026-11-07 | PK: primaria, FK: foranea, NN: obligatorio, ID: identity"];
