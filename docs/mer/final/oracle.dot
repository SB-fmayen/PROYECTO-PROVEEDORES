edge [color="#64748b", arrowsize=0.7, fontname="Arial", fontsize=10];
"ASIENTO_CONTABLE" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#16324f"><FONT COLOR="white"><B>ASIENTO_CONTABLE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IDASIENTO">IDASIENTO</TD><TD ALIGN="LEFT">NUMBER</TD><TD ALIGN="LEFT">PK NN ID</TD></TR><TR><TD ALIGN="LEFT" PORT="IDDOCUMENTOCOMPRA">IDDOCUMENTOCOMPRA</TD><TD ALIGN="LEFT">NUMBER</TD><TD ALIGN="LEFT">FK NN</TD></TR><TR><TD ALIGN="LEFT" PORT="IDPAGO">IDPAGO</TD><TD ALIGN="LEFT">NUMBER</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="FECHA">FECHA</TD><TD ALIGN="LEFT">DATE</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="CUENTACONTABLE">CUENTACONTABLE</TD><TD ALIGN="LEFT">VARCHAR2(20 BYTE)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="DEBE">DEBE</TD><TD ALIGN="LEFT">NUMBER(12,2)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="HABER">HABER</TD><TD ALIGN="LEFT">NUMBER(12,2)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="PERIODO">PERIODO</TD><TD ALIGN="LEFT">VARCHAR2(10 BYTE)</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
